{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaris-211",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yaris211-db",
      "database_id": "179aab46-46f9-470a-817c-addd29d1e682",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "DNI_RATE_LIMITER",
      "namespace_id": "21101",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
